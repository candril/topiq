{
  "name": "topiq",
  "version": "0.2.0",
  "description": "Peek, filter, replay. Kafka without leaving the terminal.",
  "license": "MIT",
  "keywords": [
    "kafka",
    "avro",
    "terminal",
    "tui",
    "cli",
    "bun"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "topiq": "./dist/topiq"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src spike scripts",
    "lint:fix": "oxlint --fix src spike scripts",
    "fmt": "oxfmt src spike scripts",
    "fmt:check": "oxfmt --check src spike scripts"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "avsc": "^5.7.9",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "undici-types": "^8.10.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
